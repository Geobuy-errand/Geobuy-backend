# ============================================================
# GEOBUY backend — environment variables
# Copy to .env and fill in. Never commit the real .env.
# ============================================================

# --- Core ---
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://user:pass@cluster/geobuy
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
# One or more frontend URLs, comma separated (e.g. UK and Nigeria domains)
FRONTEND_URL=https://geobuy.co.uk,https://geobuy.ng

# --- UK payments: Stripe (GBP) ---
STRIPE_SECRET_KEY=sk_live_...
# Webhook URL to register in Stripe: https://YOUR-API/api/subscription/webhook
#   events: checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed,
#           charge.refunded, customer.subscription.*, invoice.payment_succeeded, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Used only by the default-plan seeder
STRIPE_MONTHLY_PRICE_ID=
STRIPE_SIX_MONTH_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=

# --- Nigeria payments: Paystack (NGN) ---
PAYSTACK_SECRET_KEY=sk_live_...
# Webhook URL to register in Paystack (Settings → API Keys & Webhooks):
#   https://YOUR-API/api/webhooks/paystack
# For automatic payouts, turn OFF "Confirm transfers before sending" (OTP)
# in Paystack → Settings → Preferences, and keep your Paystack balance funded.

# --- Maps / distance ---
# Optional but recommended: Google Distance Matrix + Geocoding (live traffic,
# much better for Lagos/Abuja). Without it the app uses OSRM + OpenStreetMap.
GOOGLE_MAPS_API_KEY=
# Self-hosted OSRM is recommended for production volume; the public demo
# server is rate-limited and has no uptime guarantee.
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
# OpenStreetMap requires a real contact in the User-Agent
NOMINATIM_USER_AGENT=GEOBUY-Errands/2.0 (support@geobuy.com)
# How far (km) to look for runners around a pickup point
RUNNER_SEARCH_RADIUS_KM=25

# --- Email (Brevo) / uploads (unchanged) ---
BREVO_API_KEY=
EMAIL_ADMIN=
EMAIL_INFO=
EMAIL_SUPPORT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seeding (keep locked down in production) ---
# Lets you call /api/seed/* with header `x-seed-secret` before an admin exists.
# Remove once your admin account is set up.
SEED_SECRET=
# Required (true) for destructive routes: GET /api/seed and /api/seed/reset-all
ALLOW_DB_RESET=false

# --- Background jobs ---
# Auto-completes delivered errands after the hours set in admin settings.
# If you run several API instances, set false on all but one.
RUN_SCHEDULER=true
RATE_LIMIT_MAX=300
